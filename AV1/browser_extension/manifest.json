{
  "manifest_version": 3,
  "name": "Peacemaker-Reborn",
  "version": "1.0.0",
  "description": "Interceptor de mensagens negativas em formulários e redes sociais com base em IA.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "scripts": [
      "lib/ort.min.js",
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "config.js",
        "tts.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "vocab.json",
        "models/bilstm_model.onnx",
        "models/bilstm_model.onnx.data",
        "assets/peacemaker_closed.png",
        "assets/peacemaker_open.png",
        "assets/peacemaker_logo.png",
        "assets/peacemaker_logo_horizontal.png"
      ],
      "matches": [
        "*://*.google.com/*",
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ]
    }
  ]
}